@page
@model auto.Pages.Programari.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Programare Noua</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Programare.Data" class="control-label"></label>
                <input asp-for="Programare.Data" class="form-control" />
                <span asp-validation-for="Programare.Data" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Programare.Status" class="control-label"></label>
                <input asp-for="Programare.Status" class="form-control" />
                <span asp-validation-for="Programare.Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
    <label class="control-label">Masina (Nr. Inmatriculare)</label> 
    <select asp-for="Programare.MasinaID" class="form-control" asp-items="ViewBag.MasinaID">
        <option value="">-- Selecteaza Masina --</option>
    </select>
</div>
<div class="form-group mb-3">
                <label class="control-label">Mecanic Responsabil</label>
                <select asp-for="Programare.AngajatID" class="form-control" asp-items="ViewBag.AngajatID">
                    <option value="">-- Selecteaza Mecanic --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Servicii Solicitate:</label>
                <div class="table">
                    <table>
                        <tr>
                            @{
                                int cnt = 0;
                                foreach (var serv in Model.AssignedServiciuDataList)
                                {
                                    if (cnt++ % 3 == 0)
                                    {
                                        @:</tr><tr>
                                    }
                                    @:<td>
                                        <input type="checkbox"
                                               name="selectedServicii"
                                               value="@serv.ServiciuID"
                                               @(Html.Raw(serv.Assigned ? "checked=\"checked\"" : "")) />
                                        @serv.Nume @:(@serv.Pret RON)
                                    @:</td>
                                }
                                @:</tr>
                            }
                    </table>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Creeaza Programare" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Inapoi</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
