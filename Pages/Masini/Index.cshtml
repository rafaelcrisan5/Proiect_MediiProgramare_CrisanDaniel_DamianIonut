@page
@model auto.Pages.Masini.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Masina[0].NrInmatriculare)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Masina[0].VIN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Masina[0].Marca)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Masina[0].Model)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Masina[0].Client)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Masina) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NrInmatriculare)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.VIN)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Marca)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Model)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Client.Nume)
            </td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <span> | </span>
                        <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a>

                        <span> | </span>
                        <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                    }
    |
        
            </td>
        </tr>
}
    </tbody>
</table>
