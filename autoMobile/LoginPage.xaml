<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="autoMobile.LoginPage"
             Title="Autentificare"
             BackgroundColor="White">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Portal Service Auto" 
               FontSize="28" 
               HorizontalOptions="Center" 
               FontAttributes="Bold" 
               TextColor="#2196F3" />

        <Label Text="Introdu datele pentru a continua" 
               HorizontalOptions="Center" 
               TextColor="Gray" />

        <Entry x:Name="emailEntry" 
               Placeholder="Email (ex: myemail@me.com)" 
               Keyboard="Email" />

        <Entry x:Name="passwordEntry" 
               Placeholder="Parola" 
               IsPassword="True" />

        <Button Text="Conectare" 
                Clicked="OnLoginClicked" 
                BackgroundColor="#2196F3" 
                TextColor="White" 
                HeightRequest="50" 
                CornerRadius="10" 
                Margin="0,10,0,0"/>

        <ActivityIndicator x:Name="loadingIndicator" 
                           IsRunning="False" 
                           HorizontalOptions="Center" 
                           Color="#2196F3" />

    </VerticalStackLayout>
</ContentPage>